# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Секретный ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Название сайта (пока не выбрано)
SITE_NAME=SITE_NAME

# Хосты через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# Только для production: https-адреса сайта через запятую
CSRF_TRUSTED_ORIGINS=

# PostgreSQL. DB_HOST=localhost — для запуска manage.py и pytest с компьютера;
# внутри Docker Compose хост подменяется на db.
POSTGRES_DB=develop_lab
POSTGRES_USER=develop_lab
POSTGRES_PASSWORD=develop_lab
DB_HOST=localhost
DB_PORT=5432

# Папка с контентом (по умолчанию — content/ в корне репозитория; в Docker — /content)
# CONTENT_DIR=

# Redis (кэш). Внутри Docker Compose подменяется на redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
