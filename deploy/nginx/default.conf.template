# Конфиг Nginx для сервера. Это шаблон: при старте контейнера nginx заменяет
# ${DOMAIN} значением из окружения (переменные nginx вида $host не трогает).

upstream django {
    server web:8000;
}

# Запросы с чужим Host (сканеры, IP вместо домена) — закрываем без ответа
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

# HTTP: только проверка Let's Encrypt и редирект на HTTPS
server {
    listen 80;
    server_name ${DOMAIN};

    # certbot кладёт сюда файл-проверку, Let's Encrypt забирает его по HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Заметки и формы маленькие — большие тела запросов не нужны
    client_max_body_size 1m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json
               image/svg+xml text/plain;

    # Файлы с хешем в имени (base.3f9a1c2b7d4e.css) не меняются никогда —
    # браузер кэширует их на год и не перепроверяет
    location ~ "^/static/(.+\.[0-9a-f]{12}\..+)$" {
        alias /usr/share/nginx/static/$1;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Остальная статика (без хеша) — короткий кэш
    location /static/ {
        alias /usr/share/nginx/static/;
        expires 1h;
        access_log off;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Django узнаёт, что запрос пришёл по HTTPS (SECURE_PROXY_SSL_HEADER)
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
