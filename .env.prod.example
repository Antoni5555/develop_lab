# .env для сервера: скопируйте в ~/develop_lab/.env на сервере и заполните.
# В git этот файл попадает только как пример — настоящий .env с паролями нет.
# Инструкция — docs/deploy.md.

# --- Версия сайта (её меняет deploy.sh; руками — только для отката) ---
# Образы: ghcr.io/<владелец репозитория строчными>/develop-lab-{web,nginx}:<IMAGE_TAG>
IMAGE_PREFIX=ghcr.io/antoni5555
IMAGE_TAG=

# --- Домен ---
DOMAIN=example.com
ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
SITE_NAME=SITE_NAME

# --- PostgreSQL (доступна только внутри Docker) ---
# Пароль: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=develop_lab
POSTGRES_USER=develop_lab
POSTGRES_PASSWORD=

# --- Почта (SMTP). Пока EMAIL_HOST пуст, письма пишутся в лог контейнера web ---
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
